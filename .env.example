# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-strong-random-string-at-least-32-bytes

# SQLite by default; set to postgresql+psycopg://user:pass@host/db for Postgres.
DATABASE_URL=sqlite:///./data/atuo.db

DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
